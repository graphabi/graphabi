<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>GraphABI — {{ report.graph }} compatibility report</title>
  <style>
    :root { color-scheme: dark; --bg:#0c1220; --panel:#141d2e; --line:#2d3b53; --text:#edf2f7; --muted:#aebbd0; --pass:#4fd1a1; --fail:#ff7272; --warn:#f5b94c; }
    * { box-sizing:border-box } body { margin:0; background:var(--bg); color:var(--text); font:15px/1.55 ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif }
    main { max-width:1120px; margin:auto; padding:32px 22px 72px } h1,h2,h3 { line-height:1.2 } h1 { margin-bottom:4px } h2 { margin-top:34px }
    .eyebrow,.muted { color:var(--muted) } .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:14px }
    .card,details { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:18px } .metric { font-size:26px; font-weight:800 }
    .pass { color:var(--pass) } .fail { color:var(--fail) } .warning { color:var(--warn) } .unknown { color:var(--muted) } code,pre { font-family:ui-monospace,SFMono-Regular,Menlo,monospace }
    pre { white-space:pre-wrap; overflow-wrap:anywhere; background:#09101d; border-radius:7px; padding:13px } table { width:100%; border-collapse:collapse }
    th,td { text-align:left; padding:10px; border-bottom:1px solid var(--line); vertical-align:top } th { color:var(--muted) } summary { cursor:pointer; font-weight:700 }
    svg { width:100%; min-width:760px; height:auto } .graph-scroll { overflow-x:auto; background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:8px }
    .tag { display:inline-block; padding:2px 8px; border-radius:20px; border:1px solid currentColor; font-size:12px; font-weight:800 }
    a { color:#8cc8ff } @media (prefers-reduced-motion:reduce) { * { scroll-behavior:auto!important } }
  </style>
</head>
<body><main>
  <div class="eyebrow">GraphABI report schema {{ report.schema_version }} · {{ report.generated_at.isoformat() }}</div>
  <h1>Semantic compatibility report</h1>
  <p class="muted">{{ report.graph }} · {{ report.baseline_run_id }} → {{ report.candidate_run_id }}</p>

  <section aria-labelledby="summary"><h2 id="summary">Executive summary</h2><div class="grid">
    <div class="card"><div class="muted">Structural compatibility</div><div class="metric {{ 'pass' if report.structural.status == 'PASS' else 'fail' }}">{{ report.structural.status }}</div><p>Exact schema match: {{ report.structural.exact_schema_match }}</p></div>
    <div class="card"><div class="muted">Semantic compatibility</div><div class="metric {{ 'pass' if report.semantic.status == 'PASS' else ('warning' if report.semantic.status == 'WARNING' else ('fail' if report.semantic.status == 'FAIL' else 'unknown')) }}">{{ report.semantic.status }}</div><p>First breaking edge: <code>{{ report.semantic.first_breaking_edge or 'none' }}</code></p></div>
    <div class="card"><div class="muted">Breaking findings</div><div class="metric">{{ breaking|length }}</div><p>Derived from recorded candidate observations.</p></div>
  </div></section>

  <section aria-labelledby="graph"><h2 id="graph">Affected graph</h2><div class="graph-scroll">{{ graph_svg|safe }}</div></section>

  <section aria-labelledby="structural"><h2 id="structural">Structural compatibility</h2>
    <p>Pydantic: <strong>{{ report.structural.pydantic_model_compatible }}</strong> · JSON Schema: <strong>{{ report.structural.json_schema_compatible }}</strong></p>
    {% if report.structural.changes %}<table><thead><tr><th>Path</th><th>Change</th><th>Compatibility</th></tr></thead><tbody>{% for change in report.structural.changes %}<tr><td><code>{{ change.path }}</code></td><td>{{ change.reason }}</td><td>{{ 'BREAKING' if change.breaking else 'COMPATIBLE' }}</td></tr>{% endfor %}</tbody></table>{% else %}<p>No structural differences were detected.</p>{% endif %}
  </section>

  <section aria-labelledby="semantics"><h2 id="semantics">Semantic compatibility and edge statuses</h2>
    <table><thead><tr><th>Edge</th><th>Contract</th><th>Status</th><th>Reason</th></tr></thead><tbody>
    {% for finding in report.semantic.findings %}<tr><td><code>{{ finding.producer }} → {{ finding.consumer }}</code></td><td><code>{{ finding.contract_id.split(':')[-1] }}</code></td><td><span class="tag {{ 'fail' if finding.status == 'BREAKING' else ('warning' if finding.status == 'WARNING' else ('pass' if finding.status == 'PASS' else '')) }}">{{ finding.status }}</span></td><td>{{ finding.reason }}</td></tr>{% endfor %}
    </tbody></table>
  </section>

  <section aria-labelledby="violations"><h2 id="violations">Contract violations and witnesses</h2>
    {% for finding in report.semantic.findings if finding.status in ['BREAKING','WARNING'] %}<details {% if loop.first %}open{% endif %}>
      <summary>{{ finding.status }} · {{ finding.contract_id.split(':')[-1] }}</summary>
      <p>{{ finding.reason }}</p><p><strong>Run:</strong> <code>{{ finding.run_id }}</code> · <strong>Edge:</strong> <code>{{ finding.producer }} → {{ finding.consumer }}</code></p>
      <h3>Minimal witness</h3><pre>{{ finding.witness.model_dump_json(indent=2) }}</pre>
      <h3>Baseline versus candidate values</h3><div class="grid"><div><strong>Baseline</strong><pre>{{ finding.baseline_observation.model_dump_json(indent=2) if finding.baseline_observation else 'not observed' }}</pre></div><div><strong>Candidate</strong><pre>{{ finding.candidate_observation.model_dump_json(indent=2) if finding.candidate_observation else 'not observed' }}</pre></div></div>
      {% if finding.affected_downstream_nodes %}<h3>Downstream impact</h3><p>{{ finding.impact_explanation }}</p><p><strong>Affected:</strong> {{ finding.affected_downstream_nodes|join(', ') }}</p><p><strong>Shortest affected path:</strong> {{ finding.shortest_affected_path|join(' → ') }}</p><p><strong>Unaffected branches exist:</strong> {{ finding.unaffected_branches_exist }}</p><p><strong>Repair location:</strong> {{ finding.nearest_repair_location }}</p>{% endif %}
    </details>{% else %}<p>No warning or breaking witnesses.</p>{% endfor %}
  </section>

  <section aria-labelledby="uncertainty"><h2 id="uncertainty">Unknown and insufficient evidence</h2>
    {% set uncertain = report.semantic.findings|selectattr('status','in',['UNKNOWN','INSUFFICIENT_EVIDENCE'])|list %}
    {% if uncertain %}<ul>{% for finding in uncertain %}<li><code>{{ finding.contract_id }}</code>: {{ finding.status }} — {{ finding.reason }}</li>{% endfor %}</ul>{% else %}<p>No uncertain evaluations in this comparison.</p>{% endif %}
  </section>
  <section aria-labelledby="limitations"><h2 id="limitations">Limitations</h2><ul>{% for item in report.limitations %}<li>{{ item }}</li>{% endfor %}</ul></section>
  <section aria-labelledby="reproduce"><h2 id="reproduce">Reproduce</h2><pre>{{ report.reproduction_command }}</pre></section>
</main></body></html>
